# 这里只是配置示例，应用不会自动读取这个文件。
# 本地运行请在终端 export，或在 IDE 的运行配置中填写环境变量。

# 可选的 SMTP 提醒；未配置授权码时不会发送邮件。
INTERVIEWER_SMTP_HOST=
INTERVIEWER_SMTP_PORT=587
INTERVIEWER_SMTP_USERNAME=
INTERVIEWER_SMTP_PASSWORD=
INTERVIEWER_SMTP_FROM_EMAIL=
INTERVIEWER_SMTP_STARTTLS=true
INTERVIEWER_SMTP_USE_SSL=false
INTERVIEWER_SMTP_TIMEOUT_SECONDS=15

# 本地完整面试只需要这一个开关；它会启用仓库自带的 LiveKit/Egress 默认值、
# database_fenced 权威收音和 data/private-files 本地录像。只允许 development。
INTERVIEWER_LOCAL_MEDIA=false

# 以下是生产或自定义 LiveKit 部署项；使用上面的本地开关时不用填写。
# 正式候选人准入要求服务端权威收音和持久媒体检查点。
INTERVIEWER_LIVEKIT_URL=
INTERVIEWER_LIVEKIT_API_KEY=
INTERVIEWER_LIVEKIT_API_SECRET=
INTERVIEWER_LIVEKIT_EGRESS_URL=
INTERVIEWER_LIVEKIT_INGRESS_ENABLED=false
INTERVIEWER_LIVEKIT_INGRESS_MODE=disabled
INTERVIEWER_LIVEKIT_INGRESS_GRACE_SECONDS=30
INTERVIEWER_LIVEKIT_INGRESS_LEASE_SECONDS=15
INTERVIEWER_LIVEKIT_INGRESS_RENEW_SECONDS=5

# `python -m app.operations.interview_agent_acceptance` 生成的签名验收报告。
# 生产环境没有覆盖延迟、质量、恢复、隐私和候选人试点阈值的新报告时保持关闭。
INTERVIEWER_AGENT_ACCEPTANCE_REPORT=
INTERVIEWER_AGENT_ACCEPTANCE_REPORT_SECRET=
# 报告只能用于精确匹配的部署和版本；灰度名单必须逐个列出组织 ID，不接受通配符。
INTERVIEWER_DEPLOYMENT_ID=
INTERVIEWER_RELEASE_REVISION=
INTERVIEWER_REALTIME_AGENT_ENABLED_ORGANIZATIONS=

# 已授权的本地 VRM 1.0 资产；相对路径从项目根目录解析。
# 默认值对应仓库中的模型和不含联系方式的许可清单。
INTERVIEWER_VRM_ASSET_PATH=model/interviewer.vrm
INTERVIEWER_VRM_LICENSE_MANIFEST=model/interviewer-license.json
