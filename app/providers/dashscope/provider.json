{
  "schema_version": "2",
  "provider_id": "dashscope",
  "display_name": "阿里云百炼（千问 / Qwen）",
  "version": "0.5.1",
  "capabilities": ["llm.chat_json", "llm.chat_text", "embedding.text", "speech.dialogue_realtime", "stt.streaming", "stt.batch", "tts.synthesize"],
  "model_selection": "customizable",
  "defaults": {
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "use_environment_proxy": false
  },
  "connection_form": {
    "schema_version": "2",
    "fields": [
      {"name": "base_url", "label": "Base URL", "control": "text", "required": true, "default": "https://dashscope.aliyuncs.com/compatible-mode/v1"},
      {"name": "workspace_id", "label": "百炼业务空间 ID", "control": "text", "required": false, "help": "阿里云百炼业务空间的 WorkspaceId。填写后系统会按地域自动拼接实时 ASR 和 Qwen Realtime WebSocket 地址；留空时，需要在具体模型配置里填写完整端点。"},
      {"name": "workspace_region", "label": "业务空间地域", "control": "select", "required": true, "default": "cn-beijing", "options": [{"label": "华北 2（北京）", "value": "cn-beijing"}, {"label": "新加坡", "value": "ap-southeast-1"}]},
      {"name": "use_environment_proxy", "label": "使用环境代理", "control": "switch", "required": false, "default": false}
    ]
  },
  "credential_form": {
    "schema_version": "2",
    "fields": [
      {"name": "api_key", "label": "API Key", "control": "secret", "required": true, "write_only": true}
    ]
  },
  "model_types": {
    "llm": {"label": "大语言模型", "selection_mode": "customizable", "capabilities": ["llm.chat_json", "llm.chat_text"], "configuration_form": {"fields": [
      {"name": "enable_thinking", "label": "启用深度思考", "control": "switch", "required": false, "help": "开启后模型会进行更长的推理，适合复杂离线任务；实时面试理解和追问默认关闭，以避免短 JSON 请求超过轮转时限。"}
    ]}},
    "embedding": {"label": "Embedding", "selection_mode": "customizable", "capabilities": ["embedding.text"], "configuration_form": {"fields": [
      {"name": "dimensions", "label": "期望向量维度", "control": "number", "required": false, "min": 1}
    ]}},
    "stt": {"label": "语音识别", "selection_mode": "predefined", "capabilities": ["stt.streaming", "stt.batch"], "configuration_form": {"fields": [
      {"name": "asr_websocket_url", "label": "实时 ASR WebSocket", "control": "text", "required": false},
      {"name": "asr_batch_endpoint", "label": "批量 ASR Endpoint", "control": "text", "required": false},
      {"name": "max_sentence_silence_ms", "label": "断句静音阈值（毫秒）", "control": "number", "required": false, "default": 800, "min": 200, "max": 6000},
      {"name": "vocabulary_id", "label": "面试术语热词表 ID", "control": "text", "required": false},
      {"name": "batch_max_bytes", "label": "批量音频最大字节", "control": "number", "required": false, "default": 10485760, "min": 1024, "max": 10485760}
    ]}},
    "tts": {"label": "语音合成", "selection_mode": "customizable", "capabilities": ["tts.synthesize"], "configuration_form": {"fields": [
      {"name": "tts_endpoint", "label": "TTS Endpoint", "control": "text", "required": false},
      {"name": "default_voice", "label": "默认音色", "control": "text", "required": true, "default": "Cherry"},
      {"name": "voice_map", "label": "音色映射", "control": "key_value", "required": false},
      {"name": "sample_rate_hz", "label": "采样率", "control": "number", "required": false, "default": 24000, "min": 8000, "max": 48000},
      {"name": "force_https_assets", "label": "仅接受 HTTPS 音频资产", "control": "switch", "required": false, "default": true}
    ]}},
    "realtime_speech": {"label": "实时语音对话（S2S）", "selection_mode": "predefined", "capabilities": ["speech.dialogue_realtime"], "configuration_form": {"fields": [
      {"name": "realtime_websocket_url", "label": "Realtime WebSocket", "control": "text", "required": false, "help": "Qwen Realtime 的服务端 WebSocket 地址。已在厂商连接填写业务空间 ID 时可留空；否则填 wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime 或新加坡 ap-southeast-1 地址。系统会自动追加 ?model=当前模型。"},
      {"name": "dialogue_input_transcription_model", "label": "输入转写模型", "control": "text", "required": false, "default": "qwen3-asr-flash-realtime", "help": "S2S 会话内用于把候选人输入音频转成文字的模型；Qwen 3.5 Omni 通常保持 qwen3-asr-flash-realtime。历史值 qwen3-asr-flash 会由系统自动兼容。"},
      {"name": "dialogue_default_voice", "label": "实时对话音色", "control": "text", "required": false, "default": "Tina", "help": "Qwen Realtime 播报受控追问时使用的音色。Qwen 3.5 Omni 默认 Tina，Qwen Audio 3.0 默认 longanqian；它只影响实时追问声音，不影响权威 STT 或评分。"},
      {"name": "voice_map", "label": "音色映射", "control": "key_value", "required": false, "help": "可选 JSON 对象，用系统 voice_profile_id 映射厂商音色；没有多音色需求可留空。"}
    ]}}
  },
  "config_schema": {
    "type": "object",
    "required": ["base_url"],
    "properties": {
      "base_url": {"type": "string"},
      "workspace_id": {"type": "string"},
      "workspace_region": {"type": "string", "enum": ["cn-beijing", "ap-southeast-1"]},
      "test_model": {"type": "string"},
      "test_models": {"type": "object"},
      "tts_endpoint": {"type": "string"},
      "default_voice": {"type": "string"},
      "voice_map": {"type": "object"},
      "sample_rate_hz": {"type": "integer"},
      "force_https_assets": {"type": "boolean"},
      "asr_websocket_url": {"type": "string"},
      "asr_batch_endpoint": {"type": "string"},
      "max_sentence_silence_ms": {"type": "integer"},
      "vocabulary_id": {"type": "string"},
      "batch_max_bytes": {"type": "integer"},
      "realtime_websocket_url": {"type": "string"},
      "dialogue_input_transcription_model": {"type": "string"},
      "dialogue_default_voice": {"type": "string"},
      "use_environment_proxy": {"type": "boolean"}
      ,"enable_thinking": {"type": "boolean"}
    }
  },
  "credential_schema": {
    "type": "object",
    "required": ["api_key"],
    "properties": {
      "api_key": {"type": "string", "secret": true}
    }
  },
  "models": [
