      "configuration_form": {"fields": [
        {"name": "structured_output_mode", "label": "结构化输出模式", "control": "select", "required": false, "default": "prompt", "options": [{"label": "Prompt 约束 + Schema 校验", "value": "prompt"}, {"label": "JSON Object", "value": "json_object"}]}
      ]}
    },
