{
  "schema_version": "2",
  "provider_id": "deepseek",
  "display_name": "DeepSeek",
  "version": "1.0.0",
  "capabilities": ["llm.chat_json", "llm.chat_text"],
  "model_selection": "predefined",
  "defaults": {
    "base_url": "https://api.deepseek.com",
    "use_environment_proxy": false
  },
  "connection_form": {
    "schema_version": "2",
    "fields": [
      {"name": "base_url", "label": "Base URL", "control": "text", "required": true, "default": "https://api.deepseek.com"},
      {"name": "use_environment_proxy", "label": "使用环境代理", "control": "switch", "required": false, "default": false}
    ]
  },
  "credential_form": {
    "schema_version": "2",
    "fields": [
      {"name": "api_key", "label": "API Key", "control": "secret", "required": true, "write_only": true}
    ]
  },
  "model_types": {
    "llm": {
      "label": "大语言模型",
      "selection_mode": "predefined",
      "capabilities": ["llm.chat_json", "llm.chat_text"],
      "configuration_form": {"fields": []}
    }
  },
  "config_schema": {
    "type": "object",
    "required": ["base_url"],
    "properties": {
      "base_url": {"type": "string"},
      "test_model": {"type": "string"},
      "test_models": {"type": "object"},
      "use_environment_proxy": {"type": "boolean"},
      "timeout_s": {"type": "integer"}
    }
  },
  "credential_schema": {
    "type": "object",
    "required": ["api_key"],
    "properties": {
      "api_key": {"type": "string", "secret": true}
    }
  },
  "models": [
    {
      "model_id": "deepseek-chat",
      "label": "DeepSeek Chat",
      "capabilities": ["llm.chat_json", "llm.chat_text"],
      "default": true
    },
    {
      "model_id": "deepseek-reasoner",
      "label": "DeepSeek Reasoner",
      "capabilities": ["llm.chat_json", "llm.chat_text"]
    },
    {
      "model_id": "deepseek-v4-flash",
      "label": "DeepSeek V4 Flash",
      "capabilities": ["llm.chat_json", "llm.chat_text"]
    },
    {
      "model_id": "deepseek-v4-pro",
      "label": "DeepSeek V4 Pro",
      "capabilities": ["llm.chat_json", "llm.chat_text"]
    }
  ],
  "entrypoint": "app.providers.deepseek.provider:DeepSeekProvider",
  "implemented": true
}
