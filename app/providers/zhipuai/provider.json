{
  "schema_version": "2",
  "provider_id": "zhipuai",
  "display_name": "智谱 BigModel（GLM）",
  "version": "1.1.0",
  "capabilities": ["llm.chat_json", "llm.chat_text", "tts.synthesize"],
  "model_selection": "predefined",
  "defaults": {
    "base_url": "https://open.bigmodel.cn/api/paas/v4",
    "use_environment_proxy": false
  },
  "connection_form": {
    "schema_version": "2",
    "fields": [
      {"name": "base_url", "label": "Base URL", "control": "text", "required": true, "default": "https://open.bigmodel.cn/api/paas/v4"},
      {"name": "use_environment_proxy", "label": "使用环境代理", "control": "switch", "required": false, "default": false}
    ]
  },
  "credential_form": {
    "schema_version": "2",
    "fields": [
      {"name": "api_key", "label": "API Key", "control": "secret", "required": true, "write_only": true}
    ]
  },
  "model_types": {
    "llm": {"label": "大语言模型", "selection_mode": "predefined", "capabilities": ["llm.chat_json", "llm.chat_text"], "configuration_form": {"fields": []}},
    "tts": {"label": "语音合成", "selection_mode": "predefined", "capabilities": ["tts.synthesize"], "configuration_form": {"fields": [
      {"name": "default_voice", "label": "默认音色", "control": "text", "required": true, "default": "tongtong"},
      {"name": "voice_map", "label": "音色映射", "control": "key_value", "required": false}
    ]}}
  },
  "config_schema": {
    "type": "object",
    "required": ["base_url"],
    "properties": {
      "base_url": {"type": "string"},
      "test_model": {"type": "string"},
      "test_models": {"type": "object"},
      "timeout_s": {"type": "integer"},
      "default_voice": {"type": "string"},
      "voice_map": {"type": "object"},
      "use_environment_proxy": {"type": "boolean"}
    }
  },
  "credential_schema": {
    "type": "object",
    "required": ["api_key"],
    "properties": {
      "api_key": {"type": "string", "secret": true}
    }
  },
  "models": [
    {
      "model_id": "glm-5.2",
      "label": "GLM-5.2",
      "capabilities": ["llm.chat_json", "llm.chat_text"],
      "default": true
    },
    {
      "model_id": "glm-5.1",
      "label": "GLM-5.1",
      "capabilities": ["llm.chat_json", "llm.chat_text"]
    },
    {
      "model_id": "glm-5",
      "label": "GLM-5",
      "capabilities": ["llm.chat_json", "llm.chat_text"]
    },
    {
      "model_id": "glm-4.7-flash",
      "label": "GLM-4.7 Flash",
      "capabilities": ["llm.chat_json", "llm.chat_text"]
    },
    {
      "model_id": "glm-4.5-air",
      "label": "GLM-4.5 Air",
      "capabilities": ["llm.chat_json", "llm.chat_text"]
    },
    {
      "model_id": "glm-tts",
      "label": "GLM-TTS",
      "capabilities": ["tts.synthesize"],
      "default": true
    }
  ],
  "entrypoint": "app.providers.zhipuai.provider:ZhipuAIProvider",
  "implemented": true
}
